# Ethereum Configuration
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_PRIVATE_KEY=your_private_key_here

# BNB Chain Configuration
BNB_RPC_URL=https://bsc-dataseed.binance.org/
